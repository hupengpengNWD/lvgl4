{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "./build.sh",
            "args": ["${input:buildType}"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "./build.sh",
            "args": ["clean"]
        },
        {
            "label": "generate-bin",
            "type": "shell",
            "command": "/Applications/ArmGNUToolchain/14.2.rel1/arm-none-eabi/bin/arm-none-eabi-objcopy",
            "args": [
                "-O", "binary",
                "${workspaceFolder}/Appli/build/Appli.elf",
                "${workspaceFolder}/Appli/build/Appli.bin"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Generate Appli.bin from Appli.elf",
            "dependsOn": ["build"]
        },
        {
            "label": "flash-bin",
            "type": "shell",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c", "port=SWD",
                "-e", "all", // 擦除 QSPI Flash
                "--extload", "${workspaceFolder}/ExtMemLoader.stldr",/* 辅助加载程序的路径 */
                "-w", "${workspaceFolder}/Appli/build/Appli.bin", "0x90000000"
            ],
            "dependsOn": ["generate-bin"],
            "group": "build",
            "problemMatcher": [],
            "detail": "Generate and flash Appli.bin to QSPI Flash using STM32CubeProgrammer"
        },
        {
            "label": "flash-elf",
            "type": "shell",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c", "port=SWD",
                "-e", "all", // 擦除 QSPI Flash
                "--extload", "${workspaceFolder}/ExtMemLoader.stldr",/* 辅助加载程序的路径 */
                "-w", "${workspaceFolder}/Appli/build/Appli.elf", "0x90000000"
            ],
            // "group": "build",
            // "problemMatcher": [],
            // "dependsOn": ["build"],
            // "detail": "Flash Appli.elf to QSPI Flash using STM32CubeProgrammer"
        }
    ],
    "inputs": [
        {
            "id": "buildType",
            "type": "pickString",
            "description": "Select build type",
            "options": ["Debug", "Release", "RelWithDebInfo", "MinSizeRel"],
            "default": "Debug"
        }
    ]
}